# Copy to .env (or .env.local) and adjust. Never commit real secrets.

# PostgreSQL connection string. Leave UNSET to run on PGlite (WASM Postgres,
# zero external dependency — great for demos and Vercel).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HMAC secret used to sign session cookies. Set a long random string in
# production / on Vercel. If unset, an insecure development default is used.
VRAP_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the local PGlite data directory (default: ./.pglite-data)
# PGLITE_DATA_DIR=./.pglite-data
